{
  "name": "crafttunnel-p2p",
  "productName": "CraftTunnel P2P",
  "description": "Túnel P2P NAT Traversal via Hyperswarm DHT para partidas LAN de Minecraft sem drivers TUN/TAP",
  "author": "CraftTunnel Engineering",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('index.html', 'dist/index.html');\"",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "build": {
    "appId": "com.crafttunnel.p2p",
    "productName": "CraftTunnelP2P",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "maintainer": "CraftTunnel Team <dev@crafttunnel.local>",
      "synopsis": "Zero-Driver P2P LAN Tunnel for Minecraft"
    }
  },
  "dependencies": {
    "b4a": "^1.6.7",
    "hyperswarm": "^4.11.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
